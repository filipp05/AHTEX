# Server-only: copy to .env.server. Never use NEXT_PUBLIC_ for these values.
SITE_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3101
# Enable only behind our nginx, which replaces X-Real-IP; don't expose API publicly.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Administrative database connection, used only by scripts/database.mjs.
# Supabase direct or session-pooler URL; remote TLS certificate is verified.
DATABASE_URL=
EDITOR_EMAIL=
