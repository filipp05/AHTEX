# Server-only: copy to .env.server. Never use NEXT_PUBLIC_ for these values.
SITE_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3101
# Enable only behind our nginx, which replaces X-Real-IP; don't expose API publicly.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Persistent JSON and uploads, outside the static release directory.
DATA_DIR=./.local/data
# Daily backup destination on a separate mounted disk/server for production.
BACKUP_DIR=./.local/backups
